# Plantilla sin secretos. Para DEV, genera los archivos reales con: node infrastructure/scripts/generate-env.mjs
# Copia como frontend/.env.local. SESSION_SECRET: 64 caracteres hexadecimales (openssl rand -hex 32).
BACKEND_URL=http://localhost:4000
PORTAL_URL=http://localhost:3000
MOODLE_URL=http://localhost:8081
OIDC_ISSUER=http://localhost:8180/realms/iinicia
OIDC_CLIENT_ID=iinicia-portal
OIDC_CLIENT_SECRET=<cambiar>
SESSION_SECRET=<cambiar>
# Proxies propios delante del portal (Nginx). DEV: 0. Con Nginx: 1. Ver src/lib/client-ip.ts.
TRUSTED_PROXY_HOPS=0
