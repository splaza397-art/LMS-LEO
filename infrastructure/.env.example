# Plantilla sin secretos. Para DEV, genera los archivos reales con: node infrastructure/scripts/generate-env.mjs
# Copia como infrastructure/.env. Usa contraseñas largas y distintas para cada variable.
PORTAL_PUBLIC_URL=http://localhost:3000
MOODLE_PUBLIC_URL=http://localhost:8081
KEYCLOAK_PUBLIC_URL=http://localhost:8180
POSTGRES_PASSWORD=<cambiar>
PORTAL_DB_PASSWORD=<cambiar>
MOODLE_DB_PASSWORD=<cambiar>
KEYCLOAK_DB_PASSWORD=<cambiar>
KEYCLOAK_ADMIN_PASSWORD=<cambiar>
MOODLE_ADMIN_PASSWORD=<cambiar>
MOODLE_WS_TOKEN=<cambiar>
MOODLE_SSO_SECRET=<cambiar: 64 caracteres hexadecimales, el mismo en backend e infrastructure>
KC_PORTAL_CLIENT_SECRET=<cambiar>
KC_MOODLE_CLIENT_SECRET=<cambiar>
KC_BACKEND_CLIENT_SECRET=<cambiar>
