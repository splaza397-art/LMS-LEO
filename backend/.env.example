# Plantilla sin secretos. Para DEV, genera los archivos reales con: node infrastructure/scripts/generate-env.mjs
# Copia como backend/.env. Los valores <...> son obligatorios.
PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://portal:<cambiar>@localhost:5434/portal
CORS_ORIGINS=http://localhost:3000
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=iinicia
KEYCLOAK_BACKEND_CLIENT_ID=iinicia-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=<cambiar>
MOODLE_URL=http://localhost:8081
MOODLE_WS_TOKEN=<cambiar>
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=IINICIA <no-responder@iinicia.local>
DEMO_PASSWORD=<cambiar>
MFA_PRIVILEGED_ROLES=false
